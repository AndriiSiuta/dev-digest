node_modules/
# ROOT lockfile only (server/ and client/ lockfiles are committed): pnpm 11's
# `verify-deps-before-run` (default "install") auto-writes an EMPTY lockfile at
# the scripts-only root the moment `pnpm verify:l06` runs, and the per-project
# opt-out would require a pnpm-workspace.yaml this repo must never have.
/pnpm-lock.yaml
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json
